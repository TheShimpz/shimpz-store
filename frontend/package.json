{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "test": "node tests/run-tests.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.6.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@shimpz/frontend": "https://codeload.github.com/TheShimpz/shimpz-frontend/tar.gz/dab6070dcf2735b13adbb18ab3ac2ad5b7d7a3aa"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
