    "@tailwindcss/vite": "4.3.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.2",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@shimpz/frontend": "https://codeload.github.com/TheShimpz/shimpz-frontend/tar.gz/caa906eac9492f81063d996dab447510a67f313f"
